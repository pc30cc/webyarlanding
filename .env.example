# متغیرهای لازم برای اجرای production (Coolify / Nixpacks)
# مقادیر واقعی را در پنل Coolify (Environment Variables) وارد کنید.

# --- زمان build (باید در build هم موجود باشند) ---
VITE_SUPABASE_URL="https://xxxx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="..."
VITE_SUPABASE_PROJECT_ID="xxxx"

# --- زمان اجرا (سرور) ---
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_PUBLISHABLE_KEY="..."
# کلید service_role از داشبورد Supabase → Project Settings → API
# بدون این کلید همه صفحات با خطای «This page didn't load» بالا می‌آیند و ورود کار نمی‌کند.
SUPABASE_SERVICE_ROLE_KEY="..."

# اختیاری
# LOVABLE_CRON_SECRET=""

# کلید API سرویس‌های هوش مصنوعی (OpenAI / Google Gemini) دیگر از متغیر محیطی خوانده نمی‌شود؛
# از پنل ادمین → تنظیمات عمومی → «کلیدهای API هوش مصنوعی» وارد و در دیتابیس ذخیره می‌شود.

# --- دیتابیس PostgreSQL سلف‌هاست (Coolify) ---
# اگر تنظیم شود، سایت به‌جای Supabase مستقیماً به این Postgres وصل می‌شود و متغیرهای SUPABASE_*
# بالا دیگر برای دیتابیس لازم نیستند. راهنمای کامل: docs/self-host-postgres.md
# DATABASE_URL="postgresql://webyar:PASSWORD@webyar-db:5432/webyar"
# DATABASE_POOL_MAX=10
# برای سرور بیرونی با SSL:  ...?sslmode=require
# DATABASE_AUTO_MIGRATE=false   # غیرفعال کردن اجرای خودکار db/schema.sql هنگام بالا آمدن
