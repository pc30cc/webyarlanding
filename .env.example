# متغیرهای لازم برای اجرای production (Coolify / Nixpacks)
# مقادیر واقعی را در پنل Coolify (Environment Variables) وارد کنید.

# --- زمان build (باید در build هم موجود باشند) ---
VITE_SUPABASE_URL="https://xxxx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="..."
VITE_SUPABASE_PROJECT_ID="xxxx"

# --- زمان اجرا (سرور) ---
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_PUBLISHABLE_KEY="..."
# کلید service_role از داشبورد Supabase → Project Settings → API
# بدون این کلید همه صفحات با خطای «This page didn't load» بالا می‌آیند و ورود کار نمی‌کند.
SUPABASE_SERVICE_ROLE_KEY="..."

# اختیاری
# LOVABLE_API_KEY=""
# LOVABLE_CRON_SECRET=""
